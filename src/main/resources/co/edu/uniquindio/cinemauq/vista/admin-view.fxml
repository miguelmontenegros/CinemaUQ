<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.cinemauq.controlador.AdminControlador" styleClass="fondo">
    <top>
        <HBox styleClass="cabecera" spacing="20" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <Label text="CinemaUQ" styleClass="titulo-cabecera"/>
            <Label fx:id="lblBienvenida"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Estadísticas">
                <ScrollPane fitToWidth="true">
                    <VBox spacing="10">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Estadísticas de operación" styleClass="subtitulo"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Actualizar" onAction="#actualizarEstadisticas"/>
                        </HBox>
                        <FlowPane fx:id="panelIndicadores" hgap="10" vgap="10"/>
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <BarChart fx:id="graficoIngresos" title="Ingresos por película (compras pagadas)"
                                      legendVisible="false" animated="false" prefHeight="320"
                                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <xAxis>
                                    <CategoryAxis/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Pesos"/>
                                </yAxis>
                            </BarChart>
                            <PieChart fx:id="graficoEntradas" title="Entradas vendidas por tipo" animated="false"
                                      prefHeight="320" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <LineChart fx:id="graficoVentasDia" title="Ventas y reembolsos por día (últimos 14 días)"
                                       animated="false" createSymbols="true" prefHeight="320"
                                       GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <xAxis>
                                    <CategoryAxis/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Pesos"/>
                                </yAxis>
                            </LineChart>
                            <BarChart fx:id="graficoOcupacion" title="Ocupación promedio por sala (funciones ya realizadas)"
                                      legendVisible="false" animated="false" prefHeight="320"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <xAxis>
                                    <CategoryAxis/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Porcentaje" autoRanging="false" lowerBound="0" upperBound="100" tickUnit="10"/>
                                </yAxis>
                            </BarChart>
                            <PieChart fx:id="graficoConfiteria" title="Unidades de confitería vendidas" animated="false"
                                      prefHeight="320" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <Label text="Actividad reciente (eventos)" styleClass="subtitulo"/>
                                <ListView fx:id="lstActividad" prefHeight="290"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                </ScrollPane>
            </Tab>
            <Tab text="Reportes">
                <VBox spacing="8">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Reporte"/>
                        <ComboBox fx:id="cmbTipoReporte" prefWidth="280"/>
                        <Button text="Generar" onAction="#generarReporte" styleClass="boton-principal"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Formato"/>
                        <ComboBox fx:id="cmbFormato" prefWidth="160"/>
                        <Button text="Exportar" onAction="#exportarReporte"/>
                    </HBox>
                    <TextArea fx:id="txtReporte" editable="false" styleClass="texto-reporte" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>
            <Tab text="Tarjetas y recargas">
                <VBox spacing="8">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <Label text="Clientes" styleClass="subtitulo"/>
                    <ListView fx:id="lstClientes" onMouseClicked="#verCliente" VBox.vgrow="ALWAYS"/>
                    <Label fx:id="lblDetalleCliente" styleClass="dato"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txtValorRecarga" promptText="Valor de la recarga"/>
                        <Button text="Recargar tarjeta" onAction="#recargar" styleClass="boton-principal"/>
                        <Button text="Bloquear tarjeta" onAction="#bloquearTarjeta"/>
                        <Button text="Activar tarjeta" onAction="#activarTarjeta"/>
                    </HBox>
                    <Label text="Solicitudes de recarga pendientes" styleClass="subtitulo"/>
                    <ListView fx:id="lstSolicitudes" prefHeight="150"/>
                    <HBox spacing="8">
                        <Button text="Aprobar solicitud" onAction="#aprobarSolicitud"/>
                        <Button text="Rechazar solicitud" onAction="#rechazarSolicitud"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="Funciones">
                <VBox spacing="8">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <ListView fx:id="lstFunciones" VBox.vgrow="ALWAYS"/>
                    <Button text="Cancelar función seleccionada" onAction="#cancelarFuncion"/>
                </VBox>
            </Tab>
            <Tab text="Bitácora">
                <VBox spacing="8">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <Label text="Operaciones administrativas registradas" styleClass="subtitulo"/>
                    <ListView fx:id="lstBitacora" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>