<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.cinemauq.controlador.ClienteControlador" styleClass="fondo">
    <top>
        <HBox styleClass="cabecera" spacing="20" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <Label text="CinemaUQ" styleClass="titulo-cabecera"/>
            <Label fx:id="lblBienvenida"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblSaldoCabecera"/>
            <Label fx:id="lblPuntosCabecera"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Cartelera y compra">
                <HBox spacing="12">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <VBox spacing="8" prefWidth="320">
                        <Label text="Cartelera" styleClass="subtitulo"/>
                        <ListView fx:id="lstFunciones" onMouseClicked="#seleccionarFuncion" VBox.vgrow="ALWAYS"/>
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS" alignment="TOP_CENTER">
                        <Label fx:id="lblFuncion" wrapText="true"/>
                        <Label text="PANTALLA" styleClass="pantalla" maxWidth="Infinity"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <GridPane fx:id="gridAsientos" hgap="4" vgap="4" alignment="CENTER">
                                <padding>
                                    <Insets top="8" right="8" bottom="8" left="8"/>
                                </padding>
                            </GridPane>
                        </ScrollPane>
                        <HBox spacing="10" alignment="CENTER">
                            <Label text="Disponible" styleClass="leyenda, asiento"/>
                            <Label text="Preferencial" styleClass="leyenda, asiento, asiento-preferencial"/>
                            <Label text="Seleccionado" styleClass="leyenda, asiento, asiento-seleccionado"/>
                            <Label text="Vendido" styleClass="leyenda, asiento, asiento-vendido"/>
                            <Label text="Bloqueado" styleClass="leyenda, asiento, asiento-bloqueado"/>
                        </HBox>
                        <Label fx:id="lblSeleccion"/>
                        <HBox spacing="14" alignment="CENTER">
                            <CheckBox fx:id="chkEntradasPuntos" text="Pagar entradas con puntos"/>
                            <CheckBox fx:id="chkGafas3D"/>
                            <CheckBox fx:id="chkSillaVibratoria"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="8" prefWidth="330">
                        <Label text="Confitería" styleClass="subtitulo"/>
                        <ComboBox fx:id="cmbProductos" maxWidth="Infinity" promptText="Producto o combo"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Cantidad"/>
                            <TextField fx:id="txtCantidad" prefWidth="50"/>
                            <CheckBox fx:id="chkProductoPuntos" text="Con puntos"/>
                            <Button text="Agregar" onAction="#agregarProducto"/>
                        </HBox>
                        <ListView fx:id="lstCarrito" VBox.vgrow="ALWAYS"/>
                        <Button text="Quitar producto" onAction="#quitarProducto" maxWidth="Infinity"/>
                        <Label text="Promoción (opcional)"/>
                        <ComboBox fx:id="cmbPromocion" maxWidth="Infinity" promptText="Sin promoción"/>
                        <Button text="Revisar y pagar" onAction="#comprar" styleClass="boton-principal" maxWidth="Infinity"/>
                        <Button text="Limpiar" onAction="#limpiarCompra" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
            </Tab>
            <Tab text="Mi tarjeta">
                <VBox spacing="8">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <HBox spacing="20">
                        <Label text="Número:"/>
                        <Label fx:id="lblNumeroTarjeta" styleClass="dato"/>
                        <Label text="Estado:"/>
                        <Label fx:id="lblEstadoTarjeta" styleClass="dato"/>
                        <Label text="Saldo:"/>
                        <Label fx:id="lblSaldoTarjeta" styleClass="dato"/>
                    </HBox>
                    <Label text="Movimientos" styleClass="subtitulo"/>
                    <ListView fx:id="lstMovimientos" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txtValorRecarga" promptText="Valor (10.000 a 500.000)"/>
                        <Button text="Solicitar recarga" onAction="#solicitarRecarga"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="Mis compras">
                <VBox spacing="8">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <ListView fx:id="lstCompras" onMouseClicked="#verDetalleCompra" VBox.vgrow="ALWAYS"/>
                    <Label text="Detalle de la compra"/>
                    <ListView fx:id="lstDetalleCompra" prefHeight="150"/>
                    <Button text="Cancelar compra seleccionada" onAction="#cancelarCompra"/>
                </VBox>
            </Tab>
            <Tab text="Mis puntos">
                <VBox spacing="8">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <Label fx:id="lblPuntosDisponibles" styleClass="subtitulo"/>
                    <ListView fx:id="lstPuntos" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
